+void
+resetchord(void)
+{
+	chordlength = 0;
+	wl_event_source_timer_update(chord_timer, 0);
+}
+
+int
+chordtimeout(void *data)
+{
+	resetchord();
+	return 0;
+}
+
+ChordMatch
+trychord(uint32_t mods, const xkb_keysym_t *syms, const Chord **complete)
+{
+	xkb_keysym_t entered[CHORD_MAX_KEYS];
+	ChordMatch result;
+	size_t length = chordlength + 1;
+	uint32_t firstmods = chordlength ? chordmods : mods;
+	int i;
+
+	*complete = NULL;
+	if (length > CHORD_MAX_KEYS) {
+		resetchord();
+		return ChordNone;
+	}
+
+	for (i = 0; i < (int)chordlength; i++)
+		entered[i] = chordkeys[i];
+	for (i = 0; i < 2; i++) {
+		if (i && syms[i] == syms[0])
+			break;
+		entered[length - 1] = syms[i];
+		result = matchchord(chords, LENGTH(chords), firstmods,
+				WLR_MODIFIER_CAPS, entered, length, complete);
+		if (result == ChordNone)
+			continue;
+		if (result == ChordPrefix) {
+			memcpy(chordkeys, entered, length * sizeof(*entered));
+			chordlength = length;
+			chordmods = firstmods;
+			wl_event_source_timer_update(chord_timer, chord_timeout_ms);
+		} else {
+			resetchord();
+		}
+		return result;
+	}
+
+	if (chordlength)
+		resetchord();
+	return ChordNone;
+}
