+focusstack(const Arg *arg)
+{
+	/* Focus the next or previous client (in tiling order) on selmon */
+	Client *sel = focustop(selmon);
+	if (!sel || (sel->isfullscreen && !client_has_children(sel)))
+		return;
+	focusclient(nextvisible(sel, arg->i), 1);
