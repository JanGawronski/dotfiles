+int
+setoutputpower(Monitor *m, int mode)
+{
+	struct wlr_output_state state;
+	int was_asleep = m->asleep, committed;
+
+	m->asleep = !mode;
+	wlr_output_state_init(&state);
+	wlr_output_state_set_enabled(&state, mode);
+	committed = wlr_output_commit_state(m->wlr_output, &state);
+	wlr_output_state_finish(&state);
+	if (!committed) {
+		m->asleep = was_asleep;
+		fprintf(stderr, "dwl: failed to %s output %s\n",
+			mode ? "wake" : "turn off", m->wlr_output->name);
+		return 0;
+	}
+
+	m->gamma_lut_changed = 1;
+	if (mode && workspaceon(m->tagset[m->seltags], m))
+		m->tagset[0] = m->tagset[1] = firstfreetag(m, 0);
+	return 1;
+}
+
+int
+wakeoutputs(void)
+{
+	Monitor *m;
+	int woke = 0;
+
+	wl_list_for_each(m, &mons, link)
+		if (m->asleep)
+			woke |= setoutputpower(m, 1);
+	if (woke)
+		updatemons(NULL, NULL);
+	return woke;
+}
