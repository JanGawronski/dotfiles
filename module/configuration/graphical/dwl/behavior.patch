+
+void
+swapmaster(const Arg *arg)
+{
+	Client *sel = focustop(selmon), *master = masterclient(selmon);
+	if (!sel || !master || sel == master)
+		return;
+	swaplinks(&sel->link, &master->link);
+	focusclient(sel, 1);
+	arrange(selmon);
 }
 
+void
+swapstack(const Arg *arg)
+{
+	Client *sel = focustop(selmon), *next;
+	if (!sel || (sel->isfullscreen && !client_has_children(sel)))
+		return;
+	next = nextvisible(sel, arg->i);
+	if (next == sel)
+		return;
+	swaplinks(&sel->link, &next->link);
+	focusclient(sel, 1);
+	arrange(selmon);
+}
