+Monitor *
+workspaceon(uint32_t tag, Monitor *excluded)
+{
+	Monitor *m;
+
+	wl_list_for_each(m, &mons, link)
+		if (m != excluded && m->wlr_output->enabled && m->tagset[m->seltags] == tag)
+			return m;
+	return NULL;
+}
+
+uint32_t
+firstfreetag(Monitor *excluded, uint32_t preferred)
+{
+	Monitor *m;
+	uint32_t used = 0, tag;
+
+	wl_list_for_each(m, &mons, link)
+		if (m != excluded && m->wlr_output->enabled)
+			used |= m->tagset[m->seltags];
+	if (!(tag = initialworkspacetag(preferred, used, TAGMASK)))
+		die("dwl: invalid initial workspace or too many connected monitors");
+	return tag;
+}
